# Square API credentials. Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit your real token.
#
# Get these from https://developer.squareup.com → Developer Dashboard → your app → Credentials.
# Start with `sandbox` (fake data); switch to `production` to read your real salon data.

SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Single shared owner login (Phase 1 auth). Change the password before any real use.
APP_OWNER_USERNAME=owner
APP_OWNER_PASSWORD=changeme

# Anthropic API key for AI features (suspicious-booking triage, etc.).
# Get from https://console.anthropic.com → Settings → API Keys.
# Set a monthly spend cap in the console — guards against runaway loops in dev.
ANTHROPIC_API_KEY=

# LangSmith — LLM observability + eval dashboards for the suspicious-booking triage feature.
# Get the key from https://smith.langchain.com → Settings → API Keys.
# Project name is the LangSmith workspace where traces are filed; default is fine.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=salary-review-suspicious-triage

# Feature flag for the AI triage feature. Default off — keeps the Explain button hidden in the UI
# and the /api/suspicious/{id}/triage endpoints returning 404 until the keys above are set and
# the feature is explicitly enabled.
AI_TRIAGE_ENABLED=false
