# nginx vhost for salon.spincareer.com → the app (frontend on 127.0.0.1:3000).
# Copy to /etc/nginx/sites-available/salon.spincareer.com, symlink into sites-enabled, then:
#   sudo certbot --nginx -d salon.spincareer.com     # provisions TLS + the 443 server block
#   sudo nginx -t && sudo systemctl reload nginx
#
# The X-Forwarded-Proto header is required: the app marks its auth cookies Secure only when it sees
# https there (see frontend/app/api/login/route.ts).

server {
    listen 80;
    server_name salon.spincareer.com;
    # certbot adds the 443 ssl server block + redirects 80→443 when you run it.

    # Allow large-ish uploads/responses just in case; tune as needed.
    client_max_body_size 10m;

    # Square's payment.updated webhook, Twilio's inbound-SMS webhook, and the click-tracked short
    # link (checkout-review-request automation — see openspec/changes/sms-automations-hub) are
    # third-party-called, signature-verified endpoints that live in the backend, not the frontend.
    # Proxied straight to the backend (bypassing Next.js entirely) so the raw request body reaches
    # the signature check byte-for-byte — a JSON-parse/re-serialize round trip through a Next.js API
    # route could otherwise subtly change the bytes the signature was computed over.
    location ~ ^/(api/public/webhooks/square|api/public/sms/inbound|r/) {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;   # <-- makes the auth cookie Secure over HTTPS

        # Next.js streaming / HMR upgrade support
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 120s;
    }
}
