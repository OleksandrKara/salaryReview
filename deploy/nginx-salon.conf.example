# nginx vhost for salon.spincareer.com → the app (frontend on 127.0.0.1:3000).
# Copy to /etc/nginx/sites-available/salon.spincareer.com, symlink into sites-enabled, then:
#   sudo certbot --nginx -d salon.spincareer.com     # provisions TLS + the 443 server block
#   sudo nginx -t && sudo systemctl reload nginx
#
# The X-Forwarded-Proto header is required: the app marks its auth cookies Secure only when it sees
# https there (see frontend/app/api/login/route.ts).

server {
    listen 80;
    server_name salon.spincareer.com;
    # certbot adds the 443 ssl server block + redirects 80→443 when you run it.

    # Allow large-ish uploads/responses just in case; tune as needed.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;   # <-- makes the auth cookie Secure over HTTPS

        # Next.js streaming / HMR upgrade support
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 120s;
    }
}
